# Mockbird v2 - Variáveis de Ambiente
PROJECT_NAME="Mockbird v2"
ENVIRONMENT=homologation

# Banco de Dados (PostgreSQL 16)
DATABASE_URL="postgresql+asyncpg://mockbird:mockbird_homolog_secret@127.0.0.1:5434/mockbird_v2"
DATABASE_URL_SYNC="postgresql://mockbird:mockbird_homolog_secret@127.0.0.1:5434/mockbird_v2"

# Segurança JWT
SECRET_KEY="sua_chave_secreta_super_segura_para_homologacao"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Chave de Criptografia para Chaves de Provedores de IA (Fernet 32 url-safe base64)
ENCRYPTION_KEY="mockbird_homolog_32_byte_secret_key_sample="

# CORS
ALLOW_ORIGINS="http://localhost:8082,http://127.0.0.1:8082,http://10.8.0.7:8082,http://localhost:5173"

